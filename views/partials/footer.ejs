</main>


<div id="site-footer">
    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-column">
                <h2 class="footer-brand"><%= bankInfo.name %></h2>
                <p><%= bankInfo.tagline %></p>
                <h3>FOR SUPPORT</h3>
                <p><a href="<%= phoneLink(bankInfo.phone) %>"><%= bankInfo.phone %></a><br>
                   <a href="<%= phoneLink(bankInfo.mobile) %>"><%= bankInfo.mobile %></a></p>
            </div>
            <div class="footer-column">
                <h3>QUICK LINKS</h3>
                <ul class="footer-list">
                    <% footerQuickLinks.forEach(function (item) { %>
                    <li><a href="<%= item.link %>"><%= item.label %></a></li>
                    <% }) %>
                </ul>
            </div>
            <div class="footer-column">
                <h3>LATEST NEWS</h3>
                <ul class="footer-list footer-news">
                    <% footerNews.forEach(function (item) { %>
                    <li><a href="<%= item.link %>"><%= item.title %></a><span><%= item.date %></span></li>
                    <% }) %>
                </ul>
            </div>
            <div class="footer-column">
                <h3>CONTACT INFO</h3>
                <p><strong>Address</strong><br>
                    <% bankInfo.addressLines.forEach(function (line, i) { %><%= line %><% if (i < bankInfo.addressLines.length - 1) { %><br><% } %><% }) %></p>
                <p><strong>Phone</strong><br>
                   <a href="<%= phoneLink(bankInfo.phone) %>"><%= bankInfo.phone %></a><br>
                   <a href="<%= phoneLink(bankInfo.mobile) %>"><%= bankInfo.mobile %></a></p>
                <p class="footer-emails"><strong>Email</strong>
                    <% bankInfo.emails.forEach(function (email) { %>
                    <a href="mailto:<%= email %>"><%= email %></a>
                    <% }) %>
                </p>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">&copy; <%= bankInfo.copyrightYear %> <%= bankInfo.name %>. All rights reserved.</div>
        </div>
    </footer>
</div>


<script src="/js/navigation.js" defer></script>
<script src="/js/image-fallback.js" defer></script>
<% pageJs.forEach(function (name) { %>
<script src="/js/<%= name %>.js" defer></script>
<% }) %>
</body>
</html>
